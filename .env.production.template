# =============================================================================
# Oris Meet — PRODUCTION environment template
# Operated by Oris Intelligence Private Limited
# -----------------------------------------------------------------------------
# Copy to `.env` on your production host and fill every CHANGE_ME value.
# NEVER commit a filled-in copy. Production secrets MUST differ from dev secrets.
# Generate secrets with the openssl commands noted inline.
# =============================================================================

# --- DATABASE ----------------------------------------------------------------
# Use a managed Postgres (RDS/Cloud SQL/Neon/etc.) with a strong password.
# If you use a connection pooler (PgBouncer), DATABASE_URL points at the pooler
# and DATABASE_DIRECT_URL points at the direct connection (used for migrations).
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/orismeet?sslmode=require"
DATABASE_DIRECT_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/orismeet?sslmode=require"

# docker-compose Postgres credentials (only if you run the bundled DB container)
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=orismeet

# --- PUBLIC URLs -------------------------------------------------------------
NEXT_PUBLIC_WEBAPP_URL="https://orismeet.com"
NEXT_PUBLIC_WEBSITE_URL="https://orismeet.com"
NEXT_PUBLIC_EMBED_LIB_URL="https://orismeet.com/embed/embed.js"
NEXTAUTH_URL="https://orismeet.com"
NEXT_PUBLIC_API_V2_URL="https://orismeet.com/api/v2"
ALLOWED_HOSTNAMES='"orismeet.com"'

# --- SECRETS (generate fresh — do NOT reuse dev values) ----------------------
# openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# openssl rand -base64 24   (must be 32 chars for AES-256)
CALENDSO_ENCRYPTION_KEY="CHANGE_ME"
# openssl rand -base64 24
CALCOM_SERVICE_ACCOUNT_ENCRYPTION_KEY="CHANGE_ME"
# openssl rand -hex 32  — sent by GitHub Actions cron schedulers
CRON_API_KEY="CHANGE_ME"
# openssl rand -base64 32 — sent by Vercel Cron as `Authorization: Bearer ${CRON_SECRET}`
CRON_SECRET="CHANGE_ME"
# openssl rand -base64 32 — API v2 (NestJS) access-token signing key
JWT_SECRET="CHANGE_ME"

# --- BRANDING ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Oris Meet"
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS="support@orismeet.com"
NEXT_PUBLIC_COMPANY_NAME="Oris Intelligence Private Limited"
NEXT_PUBLIC_SENDER_ID="OrisMeet"
NEXT_PUBLIC_SENDGRID_SENDER_NAME="Oris Meet"
EMAIL_FROM_NAME="Oris Meet"

# --- EMAIL (SMTP) ------------------------------------------------------------
# REQUIRED for production. Without a real SMTP/transactional provider, all
# verification, reminder and notification emails are silently dropped.
EMAIL_FROM="notifications@orismeet.com"
EMAIL_SERVER_HOST="CHANGE_ME"          # e.g. smtp.sendgrid.net / smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="CHANGE_ME"
EMAIL_SERVER_PASSWORD="CHANGE_ME"
# Or use Resend instead of SMTP:
# RESEND_API_KEY="CHANGE_ME"

# --- SECURITY ----------------------------------------------------------------
CSP_POLICY="non-strict"
# Restrict API v2 CORS to your own domains (comma-separated). Leave empty only if
# you intentionally run an open public API.
API_CORS_ALLOWED_ORIGINS="https://orismeet.com"

# --- LEGAL -------------------------------------------------------------------
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL="https://orismeet.com/privacy"
NEXT_PUBLIC_WEBSITE_TERMS_URL="https://orismeet.com/terms"

# --- BACKGROUND TASKS --------------------------------------------------------
# Enable so reminder/notification jobs actually run in production.
TASKER_ENABLE_WEBHOOKS=1
TASKER_ENABLE_EMAILS=1

# --- MISC --------------------------------------------------------------------
CALCOM_TELEMETRY_DISABLED=1
TZ=UTC
NEXT_PUBLIC_LOGGER_LEVEL=3
NODE_ENV=production

# =============================================================================
# Integrations (Google/Microsoft/Zoom/Daily/Stripe/etc.) — add the credentials
# for whichever you enable. See .env.example for the full list of optional keys.
# Note: billing (Stripe) endpoints are stubbed in this community edition; wire up
# a payment provider before charging clients.
# =============================================================================
